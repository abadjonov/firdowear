# Django sozlamalari
SECRET_KEY=change-me-to-a-secure-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://localhost

# Do'kon ma'lumotlari
SHOP_PHONE=+998901234567
# Telegram kanali (katalog) — saytda «Telegram kanal (katalog)» bo'lib chiqadi.
# @ siz yozing; @firdowear yoki https://t.me/firdowear ham to'g'ri tushuniladi.
SHOP_TELEGRAM=firdowear
# Telegram aloqa boti — «Telegram orqali so'rash» shu botga boradi, @ siz.
# Bo'sh qoldirilsa kanal ishlatiladi.
SHOP_TELEGRAM_BOT=firdowear_bot
SHOP_INSTAGRAM=your_instagram_username
SHOP_ADDRESS_UZ=Samarqand shahri, ...
SHOP_ADDRESS_RU=г. Самарканд, ...
SHOP_HOURS=10:00 – 22:00
SHOP_MAP_EMBED='<iframe src="https://www.google.com/maps/embed?pb=..." width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>'

# Telegram bildirishnomalari (qiymatlarni qo'shtirnoqqa olmang!)
# Token SHOP_TELEGRAM_BOT dagi botniki bo'lsin: buyurtma xabari shu bot orqali ketadi.
# Tekshirish: python manage.py telegram_check
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Shaxsiy chat: 987654321 · guruh: -1001234567890
TELEGRAM_CHAT_ID=your_chat_id_here

# Ma'lumotlar bazasi (majburiy: faqat PostgreSQL)
# Lokal PostgreSQL uchun: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Production / Docker sozlamalari
DOMAIN=example.uz
SITE_URL=https://example.uz
LETSENCRYPT_EMAIL=admin@example.uz
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_here