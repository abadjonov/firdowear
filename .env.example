# Django sozlamalari
SECRET_KEY=change-me-to-a-secure-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://localhost

# Do'kon ma'lumotlari
SHOP_PHONE=+998901234567
SHOP_TELEGRAM=https://t.me/your_telegram_username
SHOP_INSTAGRAM=https://instagram.com/your_instagram_username
SHOP_ADDRESS_UZ=Samarqand shahri, ...
SHOP_ADDRESS_RU=г. Самарканд, ...
SHOP_HOURS=10:00 – 22:00
SHOP_MAP_EMBED='<iframe src="https://www.google.com/maps/embed?pb=..." width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>'

# Telegram bildirishnomalari
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Ma'lumotlar bazasi (bo'sh qoldirilsa, avtomatik SQLite ishlatiladi)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Production / Docker sozlamalari
DOMAIN=example.uz
SITE_URL=https://example.uz
LETSENCRYPT_EMAIL=admin@example.uz
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_here